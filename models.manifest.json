{
  "$schema": "klockui-models/2",
  "verified_at": "2026-11-18",
  "note": "KlockUI 不附带任何模型。本清单只描述『哪个架构需要哪几个文件、去哪下、多大、什么许可』。安装代理应先用第 0 节的询问流程确定用户要哪些架构，只下对应条目。超分模型（upscaler）是通用放大能力，不属于任何底模架构，可选装。超分模型（upscaler）与提示词转写模型（prompt-llm）是通用能力，可选装。",
  "mirrors": {
    "cn": "https://hf-mirror.com",
    "global": "https://huggingface.co"
  },
  "download_rules": [
    "URL = mirrors[当前源] + \"/\" + asset.path。国内优先 cn，失败或过慢（<300KB/s 持续 30 秒）再切 global。",
    "global 源在中国大陆通常直连不通，切换前先提示用户开启代理（Clash/V2Ray 的 HTTP 代理），再设置 HTTPS_PROXY 环境变量。",
    "每个文件下载完必须比对 size（精确字节数）；不等于清单值即判定截断，删除重下，绝不尝试加载。",
    "hf-mirror 限流时会返回 HTTP 200 但只有几百字节的错误体——判断依据永远是字节数，不是状态码。",
    "sha256 只在清单提供时校验；大文件用 size + safetensors header 双重校验即可。"
  ],
  "ask": {
    "question": "要装哪些模型的 LoRA 生态？（可多选，只影响能跑哪些底模，不影响 KlockUI 本身）",
    "options": [
      {
        "arch": "anima",
        "label": "Anima 2.9B（推荐，约 5.4GB）",
        "note": "写实/二次元通用，28–50 步，生态成熟。非商用许可。"
      },
      {
        "arch": "zimage",
        "label": "Z-Image Turbo（约 12GB）",
        "note": "9 步出图，唯一能正确渲染中文的架构。Apache-2.0。"
      },
      {
        "arch": "krea",
        "label": "Krea 2 Turbo（约 19GB）",
        "note": "画质上限最高，12.9B。8GB 显存需 --lowvram。社区许可。"
      },
      {
        "arch": "moss",
        "label": "MOSS-Image（约 13GB）",
        "note": "支持 JSON 布局排版与中英文字。Apache-2.0。"
      },
      {
        "arch": "custom",
        "label": "其他（我另有指定）",
        "note": "报模型名或链接即可。agent 按 skill.md 第十一节去 Hugging Face / Civitai / ModelScope 搜索、判架构、校验后安装；架构是新的则按 skill.md 6.2 加支持。"
      }
    ],
    "rule": "用户只选一个也能完整出图。不要默认全装——四个架构合计约 50GB；另有可选的提示词转写模型 2.5GB、超分模型 0.12GB。选「其他」时不要硬塞进上面四个架构，按 skill.md 第十一节流程处理。",
    "upscale_question": {
      "question": "要不要装 AI 超分模型（放大补细节用）？可跳过，跳过只能用 Lanczos 等插值放大，会偏糊。",
      "options": [
        {
          "id": "upscale-ultrasharp",
          "label": "UltraSharp 4x（约 64MB，通用锐利，推荐）",
          "note": "safetensors 格式，许可 CC-BY-NC-SA-4.0，非商用。"
        },
        {
          "id": "upscale-real-esrgan",
          "label": "RealESRGAN x4（约 64MB，写实基线）",
          "note": "Comfy-Org 官方 repackaged safetensors。"
        }
      ],
      "rule": "超分是通用能力，不属于任何架构，也不要求全装。至少一个都没有时，高清档只能用插值放大。"
    },
    "prompt_llm_question": {
      "question": "要不要装本地提示词转写模型（中文描述 → 英文提示词，CPU 跑不占显存，约 2.7GB）？",
      "options": [
        {
          "id": "prompt-llm-qwen35",
          "label": "Qwen3.5-4B abliterated Q4_K_M（约 2.7GB，推荐）",
          "note": "中文直出，按需启动、空闲 10 分钟自动退出。不装则转写按钮不可用，需自己写英文提示词。"
        }
      ],
      "rule": "转写是可选能力，不影响出图。它走 llama.cpp CPU，不占 ComfyUI 显存；8GB 内存机器也能跑，但会慢一些。"
    }
  },
